# Copy this file to ".env" and adjust the values.
# Relative paths are resolved against the project folder.

# Where the music is saved (one sub-folder per playlist from step 3 on).
# Tip: if the project lives inside OneDrive, point this OUTSIDE OneDrive
# (e.g. C:\Music\youtube) to avoid syncing gigabytes of MP3s.
DOWNLOAD_DIR=./downloads

# Netscape-format cookies file exported from your browser (needed from step 2 on).
# Leave as is if you don't have it yet: step 1 works without it.
# Tip: this file gives full access to your Google account. If the project is inside
# OneDrive, keep it OUTSIDE (e.g. C:\Users\<you>\yt-secrets\cookies.txt).
YT_COOKIES=./cookies.txt

# --- Playlist selection (step 2 on) ---
# Add your "Liked videos" (playlist id LL) to the list.
INCLUDE_LIKED=true
# Comma-separated playlist ids to skip. WL = Watch later.
EXCLUDE_PLAYLISTS=WL
# Comma-separated playlist ids: if set, ONLY these are used (handy for testing).
INCLUDE_PLAYLISTS=
# Comma-separated playlist ids or URLs to add even if they are not in your library,
# e.g. LM = "Liked music" of YouTube Music.
EXTRA_PLAYLISTS=

# MP3 bitrate in kbps (128, 192, 256, 320).
AUDIO_QUALITY=192

# Random pause (seconds) between two downloads, to look less like a bot.
SLEEP_MIN=2
SLEEP_MAX=6

# Optional: full path to the folder containing ffmpeg.exe, only if ffmpeg is not on PATH.
FFMPEG_LOCATION=
